pragma solidity 0.8.24;

import "forge-std/Test.sol";
import {PairHandler} from "./PairInvariants.t.sol";

/**
 * Regression for the pair share-value invariant. A long invariant run found
 * this 76-call sequence (shrunk from 356): swaps grow k, an `addLiquidity`
