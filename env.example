# ─── TimbSwap Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. It is in .gitignore.
# NEVER share your DEPLOYER_PRIVATE_KEY with anyone. 

# ─── Deployer ──────────────────────────────────────────────────

# Private key of the deployer wallet (no 0x prefix needed by Foundry)
DEPLOYER_PRIVATE_KEY=

# ─── Network ─────────────────────────────────────────────────

# Arbitrum Sepolia RPC URL
# Free options: Alchemy, Infura, QuickNode, or public https://sepolia-rollup.arbitrum.io/rpc
ARB_SEPOLIA_RPC=

# Arbiscan API key (only needed for Etherscan verification — prefer Sourcify)
ARBISCAN_API_KEY=

# ─── Protocol Wallets ───────────────────────────────────────────

# Treasury / team wallet — receives initial TIMBS mint and protocol fees.
#
# This is TimbTreasury v4, and it must match config.js. Getting it wrong is not
# a recoverable mistake: PoolLedger, UnderwriteReserve and SegmentBoard all take
# `treasury` as an IMMUTABLE constructor arg, so a wrong value here routes every
# rake, dead pot and drain into the wrong contract for the life of the
# generation, fixable only by redeploying the whole generation.
#
# This file previously carried Treasury v1 (0x486Fa4D8…), which is retired and
# has no working ERC20 exit — SPECS.md records ~6,532 TIMBS already stranded in
# it. Deploying against that address would have repeated that, on purpose.
TREASURY_ADDRESS=

# Protocol sink — receives additional-round TIMBS fees (out of circulation)
# Can be the treasury wallet or a separate burn/sink address
PROTOCOL_SINK_ADDRESS=

# ─── Token Addresses (Arbitrum Sepolia) ───────────────────────────────

# WETH (native-ETH proxy for eligibility, LP, and lock vault)
WETH_ADDRESS=

# ─── SwapTables generation deploy (scripts/DeploySegmentBoardVRF9.s.sol) ───────
# Needed only to deploy a NEW SwapTables board generation. The VRF_* values are
# network facts — read them fresh off vrf.chain.link at deploy time, never carry
# them from memory. Full runbook is in the deploy-script header.
TIMBS_ADDRESS=
TIMB_PRIZE_ADDRESS=
# Reuse the long-lived registry — NEVER deploy a new one after gen-1.
SEED_REGISTRY_ADDRESS=
# Roles — do NOT leave GUARDIAN unset in production (nobody could halt/drain).
GUARDIAN_ADDRESS=
SEED_FUNDER_ADDRESS=
# Chainlink VRF v2.5 (all network facts; VRF_EXTRA_ARGS is the nativePayment:false blob)
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUB_ID=
VRF_EXTRA_ARGS=
VRF_CONFIRMATIONS=
VRF_CALLBACK_GAS=
# Table timing dials in seconds — optional; these are the gen-9 deployed values
# (entry / place / bets-close / sit-quiet / solo-wait).
ENTRY_MAX_SECONDS=
PLACE_WINDOW_SECONDS=
BETS_CLOSE_SECONDS=
SIT_QUIET_SECONDS=
SOLO_WAIT_SECONDS=

# ─── TIMBS Token Config ────────────────────────────────────────

# Total initial TIMBS supply (18 decimals)
# 100,000,000 TIMBS = 100000000000000000000000000
INITIAL_SUPPLY=

# Initial prize game entry cost in TIMBS (18 decimals)
# 100 TIMBS = 100000000000000000000
ENTRY_COST_TIMBS=

# Initial prize game entry cost in ETH wei
# 0.001 ETH = 1000000000000000
ENTRY_COST_ETH=

# GameRegistry TIMBS entry pricing (18 dec). Fixed at deploy, never read from
# the TIMBS/WETH pair and never owner-settable. Size against THIS deployment's
# launch price: the TIMBS leg should not be far cheaper than the 0.001 ETH
# ETH-leg floor, or every entry takes the TIMBS route and the ETH escrow that
# funds the prize pot stays empty. TIMBS_STEP must be <= TIMBS_ENTRY_FLOOR.
# Derive the floor as: ETH_ENTRY_FLOOR / launch price. Step is half the floor,
# which preserves the escalation shape (cost doubles at 2 concurrent entries).
#
#   TESTNET: 2 TIMBS floor / 1 TIMBS step (2000000000000000000 / 1000000000000000000).
#     TIMBS is faucet-dripped at 1 per day there, so a launch-priced floor would
#     make the leg unreachable.
#   MAINNET at 1e-6 ETH/TIMBS (5 ETH seeded, 100 ETH FDV):
#     TIMBS_ENTRY_FLOOR=500000000000000000000    # 500 TIMBS = 0.0005 ETH, half an
#                                                # ETH ticket: a deliberate discount
#     TIMBS_STEP=100000000000000000000           # 100 TIMBS; parity with the ETH
#                                                # leg at 5 concurrent TIMBS entries
#   Re-derive both if the launch price changes. dev-docs/EMISSIONS_SCHEDULE.md §7.
TIMBS_ENTRY_FLOOR=
TIMBS_STEP=

# ─── Staking / Farm ────────────────────────────────────────────

# TIMBS staking reward rate per second (18 decimals)
# Example: 1 TIMBS/sec = 86,400 TIMBS/day
# Adjust based on intended APR and total staked expectation
REWARD_RATE_PER_SEC=

# TIMBS farm (LP) reward rate per second (18 decimals)
# LP farm typically higher rate than single-asset staking
FARM_REWARD_RATE=

# ─── Governance ─────────────────────────────────────────────

# Minimum TIMBS balance to submit a governance proposal (18 decimals)
# 1,000 TIMBS = 1000000000000000000000
PROPOSAL_THRESHOLD=

# Quorum requirement in basis points (10000 = 100%)
# 1000 = 10% of deposited voting power must participate
QUORUM_BPS=

# Voting period in seconds
# 604800 = 7 days
VOTING_PERIOD=

# Voting delay in seconds (time between proposal creation and voting start)
# 86400 = 1 day
VOTING_DELAY=

# ─── Settler (scripts/settler.js) ──────────────────────────────────
# In production these live in GitHub Actions Secrets/Variables (see settler.yml
# and README), NOT in a committed file. Listed here only for local test runs.

# Settler wallet private key — signs settleSegment() txs. NEVER commit a real one.
SETTLER_PRIVATE_KEY=

# Telegram notifications (bot token + chat IDs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_PUBLIC=

# ─── Epoch keeper (scripts/epoch.js) ────────────────────────────────
# Owner key that settles epochs, funds the waterfall, and runs buybacks. Secret.
EPOCH_PRIVATE_KEY=
# Block the first epoch scan measures from (only needed before epoch-state.json
# exists — e.g. on a fresh Treasury redeploy, reset this to the deploy block).
EPOCH_GENESIS_BLOCK=
# Buyback automation (section 0). All optional — sane defaults in the script.
BUYBACK_ENABLED=
BUYBACK_MIN_ETH=
BUYBACK_SPEND_BPS=
BUYBACK_SLIPPAGE_BPS=

# ─── X / Twitter auto-poster (scripts/xposter.js) ────────────────────────
# OAuth 1.0a user-context creds (app must have Read AND Write). Secrets — keep
# real values in .env or GitHub Secrets, never here.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Posting mode: all (default) | winners (only rounds that paid out) | off
X_POST_MODE=

# Optional trailing hashtag line. Space/comma separated ("#" added if missing).
# Use "|" to separate rotation groups — they cycle by round number so posts
# aren't byte-identical. Trimmed to fit X's 280-char limit. Not a secret.
# X_HASHTAGS=TimbSwap Arbitrum DeFi Markets DApp Testnet | TimbSwap Arbitrum DeFi Markets Web3

# Optional override for winner (🏆) posts only; falls back to X_HASHTAGS.
# X_HASHTAGS_WINNER=TimbSwap Arbitrum OnchainGaming GameFi DeFi Markets DApp

# ─── Mainnet waitlist (capture layer) ────────────────────────────────
# Landing signup form → same-origin Worker route POST /api/waitlist (workers/) →
# Supabase edge function `waitlist` + migration 20260912000000_waitlist.sql.
# Full runbook: dev-docs/WAITLIST.md.
#
# Supabase Edge Function secrets (Project Settings → Edge Functions):
#   WAITLIST_IP_SALT        random string; salts the stored IP hash (never store the raw IP)
#   WAITLIST_PROXY_SECRET   optional; must match the Worker's X-Proxy-Secret if set
#   WAITLIST_TG_CHAT_ID     optional; private founder chat that gets a ping per new signup
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are auto-injected; TELEGRAM_BOT_TOKEN is reused.)
WAITLIST_IP_SALT=
WAITLIST_PROXY_SECRET=
WAITLIST_TG_CHAT_ID=

# Cloudflare Worker (workers/) — wrangler config for the /api/waitlist proxy:
#   WAITLIST_UPSTREAM   ([vars] in wrangler.toml)  https://<supabase-ref>.supabase.co/functions/v1/waitlist
#   WAITLIST_PROXY_SECRET (wrangler secret, optional)  same value as the edge function's
WAITLIST_UPSTREAM=

# ─── Vesting (scripts/DeployVesting.s.sol) ─────────────────────────────────────
# One TimbVesting wallet per beneficiary. The script deploys and prints the Safe
# transfers; it moves no tokens. Amounts are 18-dec, same order as the addresses.
# Era-1 plan: team 7,500,000 + founder/dev 6,000,000, cliff 180 d inside a 730 d
# window (180/730 unlocks at month six, linear to month twenty-four).
#   VEST_AMOUNTS=7500000000000000000000000,6000000000000000000000000
#   VEST_CLIFF_SECONDS=15552000
#   VEST_DURATION_SECONDS=63072000
VEST_BENEFICIARIES=
VEST_AMOUNTS=
VEST_CLIFF_SECONDS=
VEST_DURATION_SECONDS=
# VEST_START=            # unix seconds; omit to use the deploy block's timestamp
