# ─── Environment ──────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Foundry ──────────────────────────────────────────────────────────────────
cache/
out/
broadcast/

# ─── Dependencies ─────────────────────────────────────────────────────────────
lib/

# ─── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ─── Remix / build artifacts (regenerable — keep out of the repo) ─────────────
.deps/
artifacts/

# ─── Local scratch / generated exports (not part of the site) ─────────────────
scratchpad/

# ─── Scratch (was tracked once by accident; regenerable or dead) ──────────────
tmp/

# ─── Private planning docs ────────────────────────────────────────────────────
# dev-docs/ is for LOCAL planning notes (economics, launch kit, incentive design,
# audit findings, etc.) — kept OUT of the public repo. Everything here is ignored
# by default; only the explicitly allowlisted ops runbooks below are tracked.
# To publish a specific doc on purpose, add a "!dev-docs/<file>" line.
dev-docs/*
!dev-docs/WAITLIST.md
!dev-docs/QUESTS_DEPLOY.md
!dev-docs/AUDIT_PREP.md
!dev-docs/FAUCET_GOLIVE.md
!dev-docs/INCIDENT_2026-09-15_SHARED_INFRA_REPOINT.md
!dev-docs/EMAIL_LOGIN.md

# ─── Node (dev-only tooling for vendored bundles; see scripts/build-vendor.mjs) ─
node_modules/
