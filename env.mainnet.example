# ─── TimbSwap — MAINNET GasFaucet deploy (scripts/DeployFaucet.s.sol) ──────────
# Copy to .env.mainnet (gitignored) and fill in the two blanks. Everything else
# here is a public on-chain fact from MAINNET_ADDRESSES.md (official repo) or a
# PROPOSED sizing — confirm the sizing against live state on deploy day (see
# dev-docs/MAINNET_FAUCET_PROPOSALS.md §1).
#
#   source .env.mainnet   # then, from the TestSwap checkout with foundry on PATH:
#   R1=https://arb1.arbitrum.io/rpc
#   forge script scripts/DeployFaucet.s.sol:DeployFaucet --rpc-url $R1 --broadcast --gas-estimate-multiplier 300
#
# NEVER commit .env.mainnet. NEVER paste DEPLOYER_PRIVATE_KEY into a chat, a
# screenshot, or a shell history you share — a key that has been seen is burned.
# Load it with `read -s DEPLOYER_PRIVATE_KEY` instead of typing it into the file.

# ─── Deployer (becomes the faucet's initial owner; hand to the Safe after) ─────
DEPLOYER_PRIVATE_KEY=

# ─── Network ──────────────────────────────────────────────────────────────────
# Arbitrum One (chain 42161). Public RPC is fine for a 5-tx deploy.
ARB_RPC=https://arb1.arbitrum.io/rpc

# ─── Already-live mainnet wiring (MAINNET_ADDRESSES.md, Phase 2) ──────────────
# Getting any of these wrong is NOT recoverable — all four are immutable
# constructor args on GasFaucet. Re-read them from the ledger, not from memory.
TREASURY_ADDRESS=0xee3e403fa75ef3b17f4763880e019ad606837834
TIMBS_ADDRESS=0x44bc0ab521191e839c3cb5bb20c9d044c8471ea1
GAME_REGISTRY_ADDRESS=0x8c40ed0cce3585b694a45106314b09dff4e04137
TIMBPRIZE_ADDRESS=0x70e7c0c1470a5d79728cd5676940883e981365ed

# ─── Roles ────────────────────────────────────────────────────────────────────
# Dispatcher: a FRESH mainnet-only hot key for the faucet keeper (gas only,
# ~0.005 ETH). Do not reuse the Sepolia faucet dispatcher (0x490A…) or the
# airdrop dispatcher (0x77F4…) — one key per leg keeps a leak contained.
FAUCET_DISPATCHER=
# Guardian: the fast pause key (may flip ethPaused / timbsPaused instantly).
# Same posture as the airdrop distributor: the deployer EOA during the beta.
FAUCET_GUARDIAN=0x42536623b503D4926DfAF6173B0357b7DfD19800

# ─── Per-claim dispense (PROPOSED — see MAINNET_FAUCET_PROPOSALS.md §1) ───────
# Invariant the numbers must satisfy on deploy day:
#     FAUCET_DRIP_ETH + FAUCET_POT_ETH  <  GameRegistry.entryCostETH()
# entryCostETH() floors at 0.001 ETH while totalEthEscrow <= 1.1 ETH, then
# tracks escrow/1000 — so at launch the floor is what you are sizing against.
#
# 0.0002 ETH to the claimant per claim (their gas: ~5–10 Arbitrum txs)
FAUCET_DRIP_ETH=200000000000000
# 0.0001 ETH to the live round pot per claim (10 % of the floor entry cost)
FAUCET_POT_ETH=100000000000000
# 1 TIMB per claim — the participation-gated "fair release" (replaces the
# retired testnet→mainnet airdrop route; MAINNET_AIRDROP_SPEC.md §15)
FAUCET_TIMBS_PER_CLAIM=100000000000000000000
# 24 h between claims per wallet (on-chain; the edge fn enforces the same)
FAUCET_COOLDOWN=86400

# ─── Approved-to-distribute ceilings (cumulative, PROPOSED) ───────────────────
# Sized as ONE MONTH at the launch estimate of ~100 active tickets/day:
#   ETH:   100 claims × 0.0003 ETH × 30 d = 0.9 ETH  → approve 1.5 ETH (headroom)
#   TIMBS: 100 claims × 100 TIMBS × 30 d = 300,000  → approve 500,000 (Era-1 budget)
# Raising a cap later is one owner tx; it is the "approve more" lever.
FAUCET_ETH_CAP=1500000000000000000
FAUCET_TIMBS_CAP=500000000000000000000000

# ─── Per-wallet ceiling (concentration guard) — NOT read by the deploy script ──
# The cooldown paces a wallet but never stops it. Over Era 1 (250 days, one claim
# per wallet per day) a single wallet can claim 251 times = 25,100 TIMBS, so only
# ~20 dedicated wallets absorb the whole 500,000 budget. Set after deploy:
#   faucet.setMaxTimbsPerWallet(5000000000000000000000)   # 5,000 TIMBS
# 5,000 = 50 claims a wallet, guaranteeing at least 100 distinct wallets are
# served and capping any one wallet at 1 % of the era budget. 0 disables it.
# Trade-off, all one owner tx to change:
#   1,000 -> 500 wallets,  10 claims each
#   2,500 -> 200 wallets,  25 claims each
#   5,000 -> 100 wallets,  50 claims each
#  10,000 ->  50 wallets, 100 claims each

# ─── NOT read by the script — the treasury-side values the owner sets after ───
# (kept here so the whole sizing sheet lives in one place; payloads in
#  MAINNET_FAUCET_PROPOSALS.md §2)
#   treasury.setOperator(<faucet>)
#   treasury.setOperatorEthCap(50000000000000000, 86400)   # 0.05 ETH / rolling 24 h
#   treasury.withdrawToken(TIMBS, <faucet>, 150000000000000000000000) # 150,000 TIMBS pre-fund

# ─── Pool seeding (scripts/seed-pools.js) — plain pools, no emissions ──────────
# Seeds WBTC/WETH, WBTC/USDC, WETH/USDT, LINK/WETH on the live Phase-1 DEX at
# Chainlink ratios. Runbook §3; dev-docs/MAINNET_LP_SEED.md. Dry run by default.
#
# EVERY address below must be re-read from Arbiscan (tokens) and the Chainlink
# "Price Feed Addresses → Arbitrum" page (feeds) before use. The script refuses
# a token whose on-chain symbol/decimals differ from the expected ones and a
# feed whose description() is not exactly "BTC / USD" etc., so a wrong address
# fails before any transaction — but check them anyway. USDC here is Circle's
# native Arbitrum USDC, not the bridged USDC.e.
SEED_ROUTER=0x4f33df838c0d357c7f1a44ffb5ee0fc49a62b5fe
SEED_FACTORY=0x60d4f18fe205c0ed38507a8fbf89aaa1bd2ce183
TOKEN_WETH=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1
TOKEN_USDT=0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9
TOKEN_WBTC=      # canonical WBTC, 8 decimals — verify
TOKEN_USDC=      # native USDC (Circle), 6 decimals — verify
TOKEN_LINK=      # canonical LINK, 18 decimals — verify
FEED_BTC_USD=    # Chainlink BTC / USD on Arbitrum One — verify
FEED_ETH_USD=    # Chainlink ETH / USD — verify
FEED_USDC_USD=   # Chainlink USDC / USD — verify
FEED_USDT_USD=   # Chainlink USDT / USD — verify
FEED_LINK_USD=   # Chainlink LINK / USD — verify
# The LP wallet. --execute only; `read -s SEED_PRIVATE_KEY`, never typed here.
SEED_PRIVATE_KEY=
# LP tokens go to the Safe (MAINNET_ADDRESSES.md owner), never the sending wallet.
SEED_LP_TO=0xFbcD2D0581a54cEE87Ab2693B9E9b7dCC19c79F9
# USD of EACH token per pool. Required, no default: a per-run decision. The dry
# run prints the exact token amounts and the wallet's balance against them.
SEED_USD_PER_SIDE=
# Refuse to join an existing pool further than this from the feed (bps)
SEED_MAX_DEVIATION_BPS=50
SEED_SLIPPAGE_BPS=100
