# ─── TimbSwap — MAINNET ETH-only capped beta (scripts/DeployBeta.s.sol) ────────
# Copy to .env.beta (gitignored) and fill the blanks. Everything pre-filled is a
# public on-chain fact from MAINNET_ADDRESSES.md. Design: dev-docs/BETA_ETH_ONLY.md.
#
#   source .env.beta
#   R1=https://arb1.arbitrum.io/rpc
#   forge script scripts/DeployBeta.s.sol --rpc-url $R1 -vvvv                 # simulate, read PRE-FLIGHT
#   forge script scripts/DeployBeta.s.sol --rpc-url $R1 --broadcast --gas-estimate-multiplier 300
#
# NEVER commit .env.beta. Load the key with `read -s DEPLOYER_PRIVATE_KEY`, never
# by typing it into this file or a shell you share.

# ─── Deployer: current owner of the Phase-2 contracts (handoff still pending)
#     and guardian of the airdrop distributor ──────────────────────────────────
DEPLOYER_PRIVATE_KEY=

# ─── Reused, live (MAINNET_ADDRESSES.md) ───────────────────────────────────────
TIMBS_TOKEN_ADDR=0x44bc0ab521191e839c3cb5bb20c9d044c8471ea1
PRIZE_ESCROW_ADDR=0xa9355021cef39be7b67fb81a1c91df53fce0dd32
ROUTER_ADDR=0x4f33df838c0d357c7f1a44ffb5ee0fc49a62b5fe
ELIGIBLE_REGISTRY_ADDR=0x0fd3777190380a12f106f57c67913f7159bc8c34
YIELD_VAULT_ADDR=0x73a33dbe76908cb2b05055931258878b0ae9b3cc
STAKING_ADDR=0xed8d6d5fe6eedcd173dbc09ef9b6474e4f155a83
TIMBS_WETH_PAIR=0x6103c1145a0090ec0e39e9e75e6efb3c0099b86f
WETH_ADDR=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1
AIRDROP_ADDR=0x955e5800245164EC4DCd1da9062115bBdA132c83

# Lapsed-principal sink: copy the CURRENT live value, do not guess.
#   cast call 0x8c40ed0cce3585b694a45106314b09dff4e04137 "protocolSink()(address)" --rpc-url $R1
PROTOCOL_SINK_ADDR=

# ─── Pre-flight guard: the game the shared infra is bound to RIGHT NOW ────────
# The script refuses to broadcast unless escrow/router/vault all point here and
# that prize has NOT started. Re-read from chain before running.
EXPECT_OLD_PRIZE=0x70e7c0c1470a5d79728cd5676940883e981365ed
EXPECT_OLD_REGISTRY=0x8c40ed0cce3585b694a45106314b09dff4e04137

# ─── VRF: copy from the live Prize VRFEntropy (0x862aa09cbdeb0d7b003b66773304c996ede7c4b9)
#   cast call 0x862aa09c… "coordinator()(address)"  "keyHash()(bytes32)"  "subId()(uint256)"  "extraArgs()(bytes)"
# Copy extraArgs VERBATIM — do not re-encode (see the gen-3 migration notes).
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUB_ID=72983366175497031969234161895668664021089442402555517736315009804992223907473
VRF_EXTRA_ARGS=
# VRF_CONFIRMATIONS=3
# VRF_CALLBACK_GAS=200000

# ─── Roles ─────────────────────────────────────────────────────────────────────
# A FRESH mainnet hot key for the faucet + top-trader keepers (gas only). Do not
# reuse the Sepolia faucet dispatcher or the airdrop dispatcher.
FAUCET_DISPATCHER=
# Optional fast-pause key (the deployer EOA during the beta).
FAUCET_GUARDIAN=0x42536623b503D4926DfAF6173B0357b7DfD19800
# Optional keeper EOA authorised for settleSegment (mainnet settler key).
SETTLER_ADDR=

# ─── Beta values (defaults in the script; uncomment to override) ──────────────
# Faucet: 0.00025 ETH to the wallet + 0.00025 ETH to the pot per claim, 24 h.
# FAUCET_DRIP_ETH=250000000000000
# FAUCET_POT_ETH=250000000000000
# FAUCET_COOLDOWN=86400
# Lifetime ETH the faucet may distribute (raise later with setEthCap).
# FAUCET_ETH_CAP=1500000000000000000
# Per-window ETH the faucet may pull from the treasury as operator.
# OPERATOR_ETH_CAP=100000000000000000
# OPERATOR_PERIOD=86400
# TIMBS entry pricing (leg is OFF in the beta; constructor needs non-zero).
# TIMBS_ENTRY_FLOOR=500000000000000000000
# TIMBS_STEP=100000000000000000000
